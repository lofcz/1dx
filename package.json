{
  "name": "1dxway",
  "version": "0.1.13",
  "description": "One DX Way",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/1dx.git"
  },
  "homepage": "https://github.com/lofcz/1dx",
  "bugs": {
    "url": "https://github.com/lofcz/1dx/issues"
  },
  "module": "src/cli.ts",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "1dx": "bin/1dx.js",
    "1dxway": "bin/1dx.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/cli.ts start",
    "install:local": "bun src/cli.ts",
    "check": "bun src/cli.ts --help",
    "typecheck": "bunx tsc --noEmit",
    "playground": "cd playground && bun ../src/cli.ts start",
    "prepublishOnly": "bun run typecheck && bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "ink": "^7.0.0",
    "react": "^19.2.5",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  }
}
